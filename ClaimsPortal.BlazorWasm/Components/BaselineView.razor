@using ClaimsPortal.BlazorWasm.Models

<style>
    .baseline-container {
        background: white;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: var(--shadow);
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .metric-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 1.5rem;
        border-radius: 8px;
        box-shadow: var(--shadow);
    }

    .metric-label {
        font-size: 0.875rem;
        opacity: 0.9;
        margin-bottom: 0.5rem;
    }

    .metric-value {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .metric-detail {
        font-size: 0.875rem;
        opacity: 0.8;
    }

    .chart-section {
        margin-bottom: 2rem;
    }

    .chart-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--text-primary);
    }

    .bar-chart {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .bar-row {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .bar-label {
        width: 120px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .bar-container {
        flex: 1;
        background: #f0f0f0;
        border-radius: 4px;
        height: 30px;
        position: relative;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        border-radius: 4px;
        transition: width 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding-right: 0.5rem;
        color: white;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .condition-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
    }

    .condition-item {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 6px;
        border-left: 4px solid var(--primary-color);
    }

    .condition-name {
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.25rem;
    }

    .condition-stats {
        display: flex;
        gap: 1rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
    }
</style>

@if (Baseline != null)
{
    <div class="baseline-container">
        <h4>Baseline Metrics - @Baseline.Segment</h4>
        <p style="color: var(--text-secondary); margin-bottom: 2rem;">
            Period: @Baseline.PeriodStart.ToString("MMM yyyy") - @Baseline.PeriodEnd.ToString("MMM yyyy")
        </p>

        <div class="metrics-grid">
            <div class="metric-card">
                <div class="metric-label">Total PMPM</div>
                <div class="metric-value">@($"{Baseline.TotalPMPM:C}")</div>
                <div class="metric-detail">@($"{Baseline.MemberMonths:N0}") member-months</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Total Allowed</div>
                <div class="metric-value">@($"{Baseline.TotalAllowed:C0}")</div>
                <div class="metric-detail">@Baseline.UniqueMemberCount members</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Population Risk Index</div>
                <div class="metric-value">@($"{Baseline.PopulationRiskIndex:N2}")</div>
                <div class="metric-detail">@(Baseline.PopulationRiskIndex >= 1.0m ? "Above" : "Below") average</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Utilization Index</div>
                <div class="metric-value">@($"{Baseline.UtilizationIndex:N2}")</div>
                <div class="metric-detail">@(Baseline.UtilizationIndex >= 1.0m ? "Above" : "Below") average</div>
            </div>
        </div>

        <div class="chart-section">
            <div class="chart-title">Service Bucket PMPM</div>
            <div class="bar-chart">
                <div class="bar-row">
                    <div class="bar-label">Inpatient</div>
                    <div class="bar-container">
                        <div class="bar-fill" style="width: @GetPercentage(Baseline.ServiceBuckets.InpatientPMPM, Baseline.TotalPMPM)%">
                            @($"{Baseline.ServiceBuckets.InpatientPMPM:C}")
                        </div>
                    </div>
                </div>
                <div class="bar-row">
                    <div class="bar-label">Outpatient</div>
                    <div class="bar-container">
                        <div class="bar-fill" style="width: @GetPercentage(Baseline.ServiceBuckets.OutpatientPMPM, Baseline.TotalPMPM)%">
                            @($"{Baseline.ServiceBuckets.OutpatientPMPM:C}")
                        </div>
                    </div>
                </div>
                <div class="bar-row">
                    <div class="bar-label">Professional</div>
                    <div class="bar-container">
                        <div class="bar-fill" style="width: @GetPercentage(Baseline.ServiceBuckets.ProfessionalPMPM, Baseline.TotalPMPM)%">
                            @($"{Baseline.ServiceBuckets.ProfessionalPMPM:C}")
                        </div>
                    </div>
                </div>
                <div class="bar-row">
                    <div class="bar-label">Pharmacy</div>
                    <div class="bar-container">
                        <div class="bar-fill" style="width: @GetPercentage(Baseline.ServiceBuckets.PharmacyPMPM, Baseline.TotalPMPM)%">
                            @($"{Baseline.ServiceBuckets.PharmacyPMPM:C}")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="chart-section">
            <div class="chart-title">Utilization Rates (per 1,000 members)</div>
            <div class="bar-chart">
                <div class="bar-row">
                    <div class="bar-label">ED Visits</div>
                    <div class="bar-container">
                        <div class="bar-fill" style="width: @GetPercentage(Baseline.Utilization.EdVisitsPer1000, 10000)%">
                            @($"{Baseline.Utilization.EdVisitsPer1000:N0}")
                        </div>
                    </div>
                </div>
                <div class="bar-row">
                    <div class="bar-label">IP Admits</div>
                    <div class="bar-container">
                        <div class="bar-fill" style="width: @GetPercentage(Baseline.Utilization.IpAdmitsPer1000, 1000)%">
                            @($"{Baseline.Utilization.IpAdmitsPer1000:N0}")
                        </div>
                    </div>
                </div>
                <div class="bar-row">
                    <div class="bar-label">OP Visits</div>
                    <div class="bar-container">
                        <div class="bar-fill" style="width: @GetPercentage(Baseline.Utilization.OpVisitsPer1000, 10000)%">
                            @($"{Baseline.Utilization.OpVisitsPer1000:N0}")
                        </div>
                    </div>
                </div>
                <div class="bar-row">
                    <div class="bar-label">Office Visits</div>
                    <div class="bar-container">
                        <div class="bar-fill" style="width: @GetPercentage(Baseline.Utilization.OfficeVisitsPer1000, 10000)%">
                            @($"{Baseline.Utilization.OfficeVisitsPer1000:N0}")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="chart-section">
            <div class="chart-title">Top 10 Conditions by Prevalence</div>
            <div class="condition-list">
                @foreach (var condition in Baseline.TopConditions.Take(10))
                {
                    <div class="condition-item">
                        <div class="condition-name">@condition.ConditionName</div>
                        <div class="condition-stats">
                            <span>@condition.MemberCount members</span>
                            <span>•</span>
                            <span>@($"{condition.PrevalenceRate:N1}")%</span>
                            <span>•</span>
                            <span>Risk: @($"{condition.AvgRiskScore:N1}")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="baseline-container">
        <p>No baseline data available. Select a segment and period to view metrics.</p>
    </div>
}

@code {
    [Parameter]
    public BaselineMetricsModel? Baseline { get; set; }

    private double GetPercentage(decimal value, decimal max)
    {
        if (max == 0) return 0;
        var pct = (double)(value / max * 100);
        return Math.Min(pct, 100);
    }
}
