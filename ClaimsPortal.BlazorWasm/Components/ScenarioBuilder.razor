@using ClaimsPortal.BlazorWasm.Services
@using ClaimsPortal.BlazorWasm.Models
@inject ActuarialService ActuarialService

<style>
    .builder-container {
        background: white;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: var(--shadow);
    }

    .builder-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .scenario-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
    }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        font-size: 1rem;
    }

    .knobs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-bottom: 2rem;
    }

    .knobs-section {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 8px;
    }

    .knobs-section h4 {
        margin: 0 0 1rem 0;
        color: var(--text-primary);
    }

    .slider-group {
        margin-bottom: 1.5rem;
    }

    .slider-label {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .slider-value {
        color: var(--primary-color);
        font-size: 1.125rem;
    }

    .slider {
        width: 100%;
        height: 8px;
        border-radius: 4px;
        background: #e0e0e0;
        outline: none;
        -webkit-appearance: none;
    }

    .slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--primary-color);
        cursor: pointer;
    }

    .slider::-moz-range-thumb {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--primary-color);
        cursor: pointer;
        border: none;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
    }

    .btn-primary, .btn-secondary {
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-primary {
        background: var(--primary-color);
        color: white;
    }

    .btn-primary:hover {
        background: var(--primary-hover);
        transform: translateY(-2px);
        box-shadow: var(--shadow-hover);
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }

    .btn-secondary:hover {
        background: #5a6268;
    }

    .btn-primary:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
    }

    .result-card {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 1.5rem;
        border-radius: 8px;
        margin-top: 2rem;
    }

    .result-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .result-metrics {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .result-metric {
        background: rgba(255, 255, 255, 0.2);
        padding: 1rem;
        border-radius: 6px;
    }

    .result-metric-label {
        font-size: 0.875rem;
        opacity: 0.9;
        margin-bottom: 0.25rem;
    }

    .result-metric-value {
        font-size: 1.5rem;
        font-weight: 700;
    }
</style>

<div class="builder-container">
    <div class="builder-header">
        <h4>Scenario Builder</h4>
    </div>

    <div class="scenario-info">
        <div class="form-group">
            <label>Scenario Name</label>
            <input type="text" class="form-control" @bind="scenarioName" placeholder="e.g., 2026 Budget - Base Case" />
        </div>
        <div class="form-group">
            <label>Description</label>
            <input type="text" class="form-control" @bind="scenarioDescription" placeholder="Brief description of this scenario" />
        </div>
    </div>

    <div class="knobs-grid">
        <div class="knobs-section">
            <h4>Core Trends</h4>
            
            <div class="slider-group">
                <div class="slider-label">
                    <span>Provider Trend</span>
                    <span class="slider-value">@($"{knobs.ProviderTrendPct:N1}")%</span>
                </div>
                <input type="range" class="slider" min="-20" max="20" step="0.5" @bind="knobs.ProviderTrendPct" @bind:event="oninput" />
            </div>

            <div class="slider-group">
                <div class="slider-label">
                    <span>Pharmacy Trend</span>
                    <span class="slider-value">@($"{knobs.PharmacyTrendPct:N1}")%</span>
                </div>
                <input type="range" class="slider" min="-30" max="30" step="0.5" @bind="knobs.PharmacyTrendPct" @bind:event="oninput" />
            </div>
        </div>

        <div class="knobs-section">
            <h4>Membership & Utilization</h4>
            
            <div class="slider-group">
                <div class="slider-label">
                    <span>Membership Change</span>
                    <span class="slider-value">@($"{knobs.MembershipDeltaPct:N1}")%</span>
                </div>
                <input type="range" class="slider" min="-30" max="30" step="1" @bind="knobs.MembershipDeltaPct" @bind:event="oninput" />
            </div>

            <div class="slider-group">
                <div class="slider-label">
                    <span>Utilization Change</span>
                    <span class="slider-value">@($"{knobs.UtilizationDeltaPct:N1}")%</span>
                </div>
                <input type="range" class="slider" min="-15" max="15" step="0.5" @bind="knobs.UtilizationDeltaPct" @bind:event="oninput" />
            </div>
        </div>

        <div class="knobs-section">
            <h4>Population Risk</h4>
            
            <div class="slider-group">
                <div class="slider-label">
                    <span>Risk Change</span>
                    <span class="slider-value">@($"{knobs.PopulationRiskDeltaPct:N1}")%</span>
                </div>
                <input type="range" class="slider" min="-10" max="10" step="0.5" @bind="knobs.PopulationRiskDeltaPct" @bind:event="oninput" />
            </div>
        </div>
    </div>

    <div class="action-buttons">
        <button class="btn-secondary" @onclick="ResetKnobs">🔄 Reset</button>
        <button class="btn-primary" @onclick="RunForecast" disabled="@isRunning">
            @if (isRunning)
            {
                <span>⏳ Running...</span>
            }
            else
            {
                <span>▶️ Run Forecast</span>
            }
        </button>
        <button class="btn-primary" @onclick="SaveScenario" disabled="@(result == null || isRunning)">
            💾 Save Scenario
        </button>
    </div>

    @if (result != null)
    {
        <div class="result-card">
            <div class="result-title">Forecast Results</div>
            <div class="result-metrics">
                <div class="result-metric">
                    <div class="result-metric-label">Forecast PMPM</div>
                    <div class="result-metric-value">@($"{result.ForecastPMPM:C}")</div>
                </div>
                <div class="result-metric">
                    <div class="result-metric-label">Delta from Baseline</div>
                    <div class="result-metric-value">@($"{result.DeltaPMPM:C}") (@($"{result.DeltaPct:N2}")%)</div>
                </div>
                <div class="result-metric">
                    <div class="result-metric-label">Forecast Member-Months</div>
                    <div class="result-metric-value">@($"{result.ForecastMemberMonths:N0}")</div>
                </div>
                <div class="result-metric">
                    <div class="result-metric-label">Forecast Allowed</div>
                    <div class="result-metric-value">@($"{result.ForecastAllowed:C0}")</div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public BaselineMetricsModel? Baseline { get; set; }

    [Parameter]
    public EventCallback<ScenarioModel> OnScenarioCreated { get; set; }

    private string scenarioName = string.Empty;
    private string scenarioDescription = string.Empty;
    private ScenarioKnobsModel knobs = new();
    private ScenarioResultModel? result;
    private bool isRunning = false;

    private void ResetKnobs()
    {
        knobs = new ScenarioKnobsModel();
        result = null;
    }

    private async Task RunForecast()
    {
        if (Baseline == null) return;

        isRunning = true;
        try
        {
            // In real implementation, this would call the backend forecast API
            result = await ActuarialService.RunScenarioAsync("temp-scenario-id");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error running forecast: {ex.Message}");
        }
        finally
        {
            isRunning = false;
        }
    }

    private async Task SaveScenario()
    {
        if (Baseline == null || result == null) return;

        try
        {
            var scenario = new ScenarioModel
            {
                Name = string.IsNullOrEmpty(scenarioName) ? $"Scenario {DateTime.Now:yyyy-MM-dd HH:mm}" : scenarioName,
                Description = scenarioDescription,
                Owner = "current-user@claimsiq.com",
                BaselineId = Baseline.BaselineId,
                Knobs = knobs,
                Result = result,
                Status = "completed",
                CreatedAt = DateTime.UtcNow,
                ComputedAt = DateTime.UtcNow
            };

            var created = await ActuarialService.CreateScenarioAsync(scenario);
            await OnScenarioCreated.InvokeAsync(created);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving scenario: {ex.Message}");
        }
    }
}
