</div>

<style>
    .stat-card {
        border-left: 4px solid var(--primary-color);
        transition: transform 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-hover);
    }

    .stat-icon {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: bold;
        color: var(--primary-color);
        margin: 0;
    }

    .stat-label {
        color: var(--text-secondary);
        margin: 0;
        font-size: 0.9rem;
    }

    .tier-card {
        border-radius: 8px;
        overflow: hidden;
        box-shadow: var(--shadow);
        height: 100%;
    }

    .tier-card.tier-1 .tier-header {
        background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
        color: #333;
    }

    .tier-card.tier-2 .tier-header {
        background: linear-gradient(135deg, #c0c0c0 0%, #e8e8e8 100%);
        color: #333;
    }

    .tier-card.tier-3 .tier-header {
        background: linear-gradient(135deg, #cd7f32 0%, #e9a76f 100%);
        color: white;
    }

    .tier-header {
        padding: 1rem;
        text-align: center;
    }

    .tier-header h5 {
        margin: 0;
        font-weight: bold;
    }

    .tier-body {
        padding: 1rem;
        background: white;
    }

    .tier-body ul {
        padding-left: 1.2rem;
        margin-bottom: 0;
    }

    .tier-body li {
        font-size: 0.875rem;
        margin-bottom: 0.25rem;
    }
</style>

@code {
    private string searchTerm = "";
    private string selectedNetwork = "";
    private string selectedSpecialty = "";
    
    private int totalProviders = 0;
    private int activeContracts = 0;
    private int pendingReviews = 0;
    private List<NetworkTier> networkTiers = new();
    private List<Provider> providers = new();
    private List<ProviderContract> contracts = new();
    private bool showAddProviderModal = false;
    private bool showAddContractModal = false;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            // Load providers
            var providerResponse = await ProviderService.SearchProvidersAsync(new ProviderSearchRequest 
            { 
                PageNumber = 1, 
                PageSize = 1000 
            });
            providers = providerResponse.Providers;
            totalProviders = providerResponse.TotalCount;

            // Load contracts
            contracts = await ProviderService.GetContractsAsync();
            activeContracts = contracts.Count(c => c.Status == "Active");
            pendingReviews = contracts.Count(c => c.Status == "Pending");

            // Load network tiers
            networkTiers = await ProviderService.GetNetworkTiersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            Console.WriteLine(errorMessage);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddProviderModal()
    {
        showAddProviderModal = true;
    }

    private void OpenAddContractModal()
    {
        showAddContractModal = true;
    }

    private async Task AddNewContract(ProviderContract contract)
    {
        try
        {
            var created = await ProviderService.CreateContractAsync(contract);
            if (created != null)
            {
                contracts.Add(created);
                activeContracts++;
                showAddContractModal = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating contract: {ex.Message}";
        }
    }

    private async Task UpdateProviderTier(string npi, string newTier)
    {
        try
        {
            var success = await ProviderService.UpdateProviderTierAsync(npi, newTier);
            if (success)
            {
                // Reload dashboard data to reflect changes
                await LoadDashboardData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating tier: {ex.Message}";
        }
    }

    private async Task RemoveProviderAsync(string npi)
    {
        try
        {
            var success = await ProviderService.RemoveProviderAsync(npi);
            if (success)
            {
                providers.RemoveAll(p => p.Npi == npi);
                totalProviders = providers.Count;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error removing provider: {ex.Message}";
        }
    }

    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }
}
