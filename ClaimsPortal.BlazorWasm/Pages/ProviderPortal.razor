                </div>
            </div>
        </div>
    </div>

    <!-- Plan Associations -->
    <div class="card">
        <div class="card-header">
            <h4>📋 Plan & Network Associations</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Plan Name</th>
                            <th>Plan ID</th>
                            <th>Network Type</th>
                            <th>Tier 1 Access</th>
                            <th>Tier 2 Access</th>
