@page "/provider-portal"
@using ClaimsPortal.BlazorWasm.Services
@inject NavigationManager Navigation
@inject ProviderPortalService ProviderService

<PageTitle>Provider Portal - ClaimsIQ Platform</PageTitle>

<div class="page-container">
    <div class="page-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <h3>🤝 Provider Portal</h3>
        <p class="subtitle">Payer-Provider Network & Contract Management</p>
    </div>

    <!-- Dashboard Overview -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="card-body text-center">
                    <div class="stat-icon">🏥</div>
                    <h2 class="stat-number">@totalProviders</h2>
                    <p class="stat-label">Network Providers</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="card-body text-center">
                    <div class="stat-icon">📄</div>
                    <h2 class="stat-number">@activeContracts</h2>
                    <p class="stat-label">Active Contracts</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="card-body text-center">
                    <div class="stat-icon">🌐</div>
                    <h2 class="stat-number">@networkTiers.Count</h2>
                    <p class="stat-label">Network Tiers</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="card-body text-center">
                    <div class="stat-icon">⚠️</div>
                    <h2 class="stat-number">@pendingReviews</h2>
                    <p class="stat-label">Pending Reviews</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Network Management -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4>🌐 Network Management</h4>
            <button class="btn btn-primary btn-sm" @onclick="OpenAddProviderModal">➕ Add Provider to Network</button>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <input type="text" class="form-control" placeholder="Search by Provider Name, NPI, or TIN" @bind="searchTerm" />
                </div>
                <div class="col-md-3">
                    <select class="form-control" @bind="selectedNetwork">
                        <option value="">All Networks</option>
                        <option value="tier1">Tier 1 - Premium</option>
                        <option value="tier2">Tier 2 - Standard</option>
                        <option value="tier3">Tier 3 - Basic</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-control" @bind="selectedSpecialty">
                        <option value="">All Specialties</option>
                        <option value="pcp">Primary Care</option>
                        <option value="cardio">Cardiology</option>
                        <option value="ortho">Orthopedics</option>
                        <option value="derm">Dermatology</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-secondary w-100">🔍 Search</button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Provider Name</th>
                            <th>NPI</th>
                            <th>Specialty</th>
                            <th>Network Tier</th>
                            <th>Contract Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Dr. Sarah Johnson</strong><br /><small>Primary Care Associates</small></td>
                            <td>1234567890</td>
                            <td>Primary Care</td>
                            <td><span class="badge bg-success">Tier 1</span></td>
                            <td><span class="badge bg-success">Active</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick='() => NavigateTo("/provider-details/1")'>👁️ View</button>
                                <button class="btn btn-sm btn-outline-secondary">📄 Contract</button>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Dr. Michael Chen</strong><br /><small>Cardiology Specialists</small></td>
                            <td>9876543210</td>
                            <td>Cardiology</td>
                            <td><span class="badge bg-info">Tier 2</span></td>
                            <td><span class="badge bg-success">Active</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick='() => NavigateTo("/provider-details/2")'>👁️ View</button>
                                <button class="btn btn-sm btn-outline-secondary">📄 Contract</button>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Dr. Emily Rodriguez</strong><br /><small>Orthopedic Center</small></td>
                            <td>5551234567</td>
                            <td>Orthopedics</td>
                            <td><span class="badge bg-warning text-dark">Tier 3</span></td>
                            <td><span class="badge bg-warning text-dark">Pending Renewal</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick='() => NavigateTo("/provider-details/3")'>👁️ View</button>
                                <button class="btn btn-sm btn-outline-secondary">📄 Contract</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Contract Management -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4>📄 Contract Management</h4>
            <button class="btn btn-primary btn-sm">➕ Create New Contract</button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Contract ID</th>
                            <th>Provider/Group</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Reimbursement Model</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
