                                <button class="btn btn-sm btn-outline-secondary">✏️ Edit</button>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>CONT-2026-002</strong></td>
                            <td>Cardiology Specialists</td>
                            <td>03/01/2026</td>
                            <td>02/28/2027</td>
                            <td><span class="badge bg-info">Capitation</span></td>
                            <td><span class="badge bg-success">Active</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1">👁️ View</button>
                                <button class="btn btn-sm btn-outline-secondary">✏️ Edit</button>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>CONT-2025-089</strong></td>
                            <td>Orthopedic Center</td>
                            <td>06/01/2025</td>
                            <td>05/31/2026</td>
                            <td><span class="badge bg-warning text-dark">Value-Based</span></td>
                            <td><span class="badge bg-warning text-dark">Expiring Soon</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1">👁️ View</button>
                                <button class="btn btn-sm btn-outline-danger">🔄 Renew</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Network Tiers Configuration -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4>🏆 Network Tier Configuration</h4>
            <button class="btn btn-primary btn-sm">⚙️ Manage Tiers</button>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="tier-card tier-1">
                        <div class="tier-header">
                            <h5>🏆 Tier 1 - Premium</h5>
                        </div>
                        <div class="tier-body">
                            <p><strong>Member Cost Share:</strong> Lowest</p>
                            <p><strong>Provider Count:</strong> 95 providers</p>
                            <p><strong>Quality Score:</strong> ⭐⭐⭐⭐⭐ 4.8/5.0</p>
                            <p><strong>Requirements:</strong></p>
                            <ul>
                                <li>NCQA recognition</li>
                                <li>HEDIS top 25%</li>
                                <li>5+ years experience</li>
                            </ul>
                            <button class="btn btn-outline-primary btn-sm w-100 mt-2">View Providers</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="tier-card tier-2">
                        <div class="tier-header">
                            <h5>🥈 Tier 2 - Standard</h5>
                        </div>
                        <div class="tier-body">
                            <p><strong>Member Cost Share:</strong> Moderate</p>
                            <p><strong>Provider Count:</strong> 128 providers</p>
                            <p><strong>Quality Score:</strong> ⭐⭐⭐⭐ 4.2/5.0</p>
                            <p><strong>Requirements:</strong></p>
                            <ul>
                                <li>Board certified</li>
                                <li>HEDIS top 50%</li>
                                <li>3+ years experience</li>
                            </ul>
                            <button class="btn btn-outline-info btn-sm w-100 mt-2">View Providers</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="tier-card tier-3">
                        <div class="tier-header">
                            <h5>🥉 Tier 3 - Basic</h5>
                        </div>
                        <div class="tier-body">
                            <p><strong>Member Cost Share:</strong> Highest</p>
                            <p><strong>Provider Count:</strong> 24 providers</p>
