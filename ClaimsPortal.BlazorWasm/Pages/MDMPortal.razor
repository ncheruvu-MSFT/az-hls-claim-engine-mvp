@page "/mdm"
@using ClaimsPortal.BlazorWasm.Services
@using ClaimsPortal.BlazorWasm.Models
@using ClaimsPortal.BlazorWasm.Components
@inject MdmService MdmService

<PageTitle>MDM Portal - ClaimsIQ Platform</PageTitle>

<style>
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .page-header h3 {
        margin: 0 0 0.5rem 0;
        font-size: 1.75rem;
    }

    .subtitle {
        margin: 0;
        opacity: 0.9;
        font-size: 1rem;
    }

    .card {
        background: var(--card-bg);
        border-radius: 8px;
        box-shadow: var(--shadow);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .card:hover {
        box-shadow: var(--shadow-hover);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: var(--shadow);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-hover);
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--primary-color);
        margin: 0.5rem 0;
    }

    .stat-label {
        color: var(--text-secondary);
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-icon {
        font-size: 2rem;
        opacity: 0.2;
        float: right;
    }

    .tab-nav {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
        border-bottom: 2px solid var(--border-color);
    }

    .tab-button {
        background: none;
        border: none;
        padding: 1rem 1.5rem;
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-secondary);
        cursor: pointer;
        border-bottom: 3px solid transparent;
        transition: all 0.2s ease;
    }

    .tab-button:hover {
        color: var(--primary-color);
    }

    .tab-button.active {
        color: var(--primary-color);
        border-bottom-color: var(--primary-color);
    }

    .chart-container {
        height: 300px;
        display: flex;
        align-items: flex-end;
        justify-content: space-around;
        gap: 1rem;
        padding: 1rem;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .chart-bar {
        flex: 1;
        background: linear-gradient(180deg, var(--primary-color) 0%, #667eea 100%);
        border-radius: 4px 4px 0 0;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
        padding: 0.5rem;
        color: white;
        font-weight: 600;
        position: relative;
    }

    .chart-bar:hover {
        opacity: 0.8;
        transform: scale(1.05);
    }

    .chart-label {
        position: absolute;
        bottom: -30px;
        font-size: 0.75rem;
        color: var(--text-secondary);
        white-space: nowrap;
    }

    .resource-type-selector {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .resource-btn {
        padding: 0.75rem 1.5rem;
        border: 2px solid var(--border-color);
        background: white;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .resource-btn:hover {
        border-color: var(--primary-color);
        color: var(--primary-color);
    }

    .resource-btn.active {
        background: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
    }

    .quick-actions {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .action-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 1rem;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: transform 0.2s ease;
        text-align: center;
    }

    .action-btn:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-hover);
    }

    .badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .badge-warning {
        background: #fff3cd;
        color: #856404;
    }

    .badge-success {
        background: #d4edda;
        color: #155724;
    }

    .badge-info {
        background: #d1ecf1;
        color: #0c5460;
    }
</style>

<div class="page-header">
    <h3>🔗 Master Data Management (MDM) Portal</h3>
    <p class="subtitle">Manage patient, provider, and organization matching and deduplication</p>
</div>

<div class="resource-type-selector">
    <button class="resource-btn @(selectedResourceType == "Patient" ? "active" : "")" @onclick="@(() => SelectResourceType("Patient"))">
        👤 Patient
    </button>
    <button class="resource-btn @(selectedResourceType == "Practitioner" ? "active" : "")" @onclick="@(() => SelectResourceType("Practitioner"))">
        🏥 Practitioner
    </button>
    <button class="resource-btn @(selectedResourceType == "Organization" ? "active" : "")" @onclick="@(() => SelectResourceType("Organization"))">
        🏢 Organization
    </button>
</div>

<div class="tab-nav">
    <button class="tab-button @(activeTab == "dashboard" ? "active" : "")" @onclick="@(() => activeTab = "dashboard")">
        📊 Dashboard
    </button>
    <button class="tab-button @(activeTab == "review" ? "active" : "")" @onclick="@(() => activeTab = "review")">
        ✅ Review Queue @if (metrics?.PendingReviewCount > 0)
        {
            <span class="badge badge-warning">@metrics.PendingReviewCount</span>
        }
    </button>
    <button class="tab-button @(activeTab == "config" ? "active" : "")" @onclick="@(() => activeTab = "config")">
        ⚙️ Configuration
    </button>
    <button class="tab-button @(activeTab == "audit" ? "active" : "")" @onclick="@(() => activeTab = "audit")">
        📋 Audit Log
    </button>
</div>

@if (activeTab == "dashboard")
{
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">🔗</div>
            <div class="stat-label">Total Golden Resources</div>
            <div class="stat-value">@($"{metrics?.TotalGoldenResources ?? 0:N0}")</div>
            <small class="text-muted">@($"{metrics?.ActiveGoldenResources ?? 0:N0}") active</small>
        </div>

        <div class="stat-card">
            <div class="stat-icon">✅</div>
            <div class="stat-label">Confirmed Matches</div>
            <div class="stat-value">@($"{(metrics?.LinkCountsByResult.TryGetValue("MATCH", out var matchCount) == true ? matchCount : 0):N0}")</div>
            <small class="text-muted">@($"{metrics?.AutoLinksCount ?? 0:N0}") automatic</small>
        </div>

        <div class="stat-card">
            <div class="stat-icon">⚠️</div>
            <div class="stat-label">Pending Review</div>
            <div class="stat-value">@($"{metrics?.PendingReviewCount ?? 0:N0}")</div>
            <small class="text-muted">Possible matches</small>
        </div>

        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <div class="stat-label">Reviewed Today</div>
            <div class="stat-value">@($"{metrics?.ReviewedTodayCount ?? 0:N0}")</div>
            <small class="text-muted">Avg @($"{metrics?.AverageReviewTime ?? 0:N1}") min</small>
        </div>
    </div>

    <div class="card">
        <h4>📊 Match Results Distribution</h4>
        <div class="chart-container">
            @if (metrics?.LinkCountsByResult != null)
            {
                @foreach (var result in metrics.LinkCountsByResult.OrderByDescending(x => x.Value))
                {
                    var height = metrics.LinkCountsByResult.Values.Max() > 0 ? (result.Value * 100.0 / metrics.LinkCountsByResult.Values.Max()) : 0;
                    <div class="chart-bar" style="height: @(height)%;">
                        @result.Value
                        <span class="chart-label">@result.Key</span>
                    </div>
                }
            }
        </div>
    </div>

    <div class="card">
        <h4>🚀 Quick Actions</h4>
        <div class="quick-actions">
            <button class="action-btn" @onclick="NavigateToReview">
                ✅ Review Matches (@($"{metrics?.PendingReviewCount ?? 0}"))
            </button>
            <button class="action-btn" @onclick="NavigateToConfig">
                ⚙️ Configure Rules
            </button>
            <button class="action-btn" @onclick="RefreshDashboard">
                🔄 Refresh Dashboard
            </button>
        </div>
    </div>
}
else if (activeTab == "review")
{
    <MDMReviewQueue ResourceType="@selectedResourceType" />
}
else if (activeTab == "config")
{
    <MDMConfiguration ResourceType="@selectedResourceType" />
}
else if (activeTab == "audit")
{
    <MDMAuditLog ResourceType="@selectedResourceType" />
}

@code {
    private string activeTab = "dashboard";
    private string selectedResourceType = "Patient";
    private MdmMetricsModel? metrics;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        metrics = await MdmService.GetMetricsAsync(selectedResourceType);
    }

    private async Task SelectResourceType(string resourceType)
    {
        selectedResourceType = resourceType;
        await LoadDashboardAsync();
    }

    private void NavigateToReview()
    {
        activeTab = "review";
    }

    private void NavigateToConfig()
    {
        activeTab = "config";
    }

    private async Task RefreshDashboard()
    {
        await LoadDashboardAsync();
    }
}
