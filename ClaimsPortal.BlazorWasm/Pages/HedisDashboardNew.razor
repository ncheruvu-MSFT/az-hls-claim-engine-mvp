@page "/hedis-dashboard"
@using ClaimsPortal.BlazorWasm.Services
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>HEDIS Quality Dashboard - ClaimsIQ Platform</PageTitle>

<div class="page-header">
    <h3>📊 HEDIS Quality Dashboard</h3>
    <p class="subtitle">NCQA Healthcare Effectiveness Data and Information Set - Real-time Quality Performance</p>
</div>

@if (isLoading)
{
    <div class="card">
        <div style="text-align: center; padding: 3rem;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p style="margin-top: 1rem;">Calculating HEDIS measures...</p>
        </div>
    </div>
}
else if (dashboard != null)
{
    <!-- Star Rating & Summary Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">⭐</div>
            <div class="stat-label">CMS Star Rating</div>
            <div class="stat-value">@dashboard.OverallStarRating.ToString("F1")</div>
            <small style="color: #107c10;">↑ Projected: @dashboard.ProjectedStarRating.ToString("F1")</small>
        </div>

        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <div class="stat-label">Total Members</div>
            <div class="stat-value">@dashboard.TotalMembers.ToString("N0")</div>
            <small>@dashboard.PlanSegment</small>
        </div>

        <div class="stat-card">
            <div class="stat-icon">📋</div>
            <div class="stat-label">Measures Tracked</div>
            <div class="stat-value">@dashboard.Measures.Count</div>
            <small>Year @dashboard.MeasurementYear</small>
        </div>

        <div class="stat-card">
            <div class="stat-icon">⚠️</div>
            <div class="stat-label">Care Gaps</div>
            <div class="stat-value" style="color: #ff8c00;">@dashboard.TotalGaps.ToString("N0")</div>
            <small>@(Math.Round((double)dashboard.TotalGaps / dashboard.TotalMembers * 100, 1))% of members</small>
        </div>
    </div>

    <!-- Priority Actions -->
    @if (dashboard.PriorityActions.Any())
    {
        <div class="card">
            <div class="card-header">
                <h4>🎯 Priority Gap Closure Actions</h4>
                <p>Top opportunities for Star Rating improvement</p>
            </div>
            <div class="card-body">
                <div class="priority-actions-grid">
                    @foreach (var action in dashboard.PriorityActions)
                    {
                        <div class="priority-action-card">
                            <div class="action-header">
                                <h5>@action.MeasureId - @action.MeasureName</h5>
                                <span class="star-impact" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                    +@action.StarRatingImpact.ToString("F2") ⭐
                                </span>
                            </div>
                            <div class="action-stats">
                                <div class="action-stat">
                                    <span class="label">Gaps:</span>
                                    <span class="value">@action.GapCount.ToString("N0")</span>
                                </div>
                                <div class="action-stat">
                                    <span class="label">Current:</span>
                                    <span class="value">@action.CurrentRate.ToString("F1")%</span>
                                </div>
                                <div class="action-stat">
                                    <span class="label">Target:</span>
                                    <span class="value" style="color: #107c10;">@action.TargetRate.ToString("F1")%</span>
                                </div>
                            </div>
                            <div class="action-approach">
                                <strong>Recommended Approach:</strong> @action.RecommendedApproach
                            </div>
                            <button class="btn btn-primary btn-sm" @onclick="() => ViewGaps(action.MeasureId)">
                                View Gap List →
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Measures Grid -->
    <div class="card">
        <div class="card-header">
            <h4>📊 HEDIS Measure Performance</h4>
            <div class="filter-controls">
                <select class="form-control" @onchange="HandleCategoryFilter" style="width: auto;">
                    <option value="All">All Categories</option>
                    <option value="Effectiveness of Care">Effectiveness of Care</option>
                    <option value="Prevention & Screening">Prevention & Screening</option>
                </select>
            </div>
        </div>
        <div class="card-body">
            <div class="measures-grid">
                @foreach (var measure in GetFilteredMeasures())
                {
                    <div class="measure-card">
                        <div class="measure-header">
                            <div>
                                <h5>@measure.MeasureId</h5>
                                <p class="measure-name">@measure.MeasureName</p>
                                <span class="category-badge">@measure.MeasureCategory</span>
                            </div>
                            <div class="measure-rate-circle" style="background: @GetRateColor(measure.Rate);">
                                <span class="rate-value">@measure.Rate.ToString("F1")%</span>
                            </div>
                        </div>

                        <div class="measure-stats-row">
                            <div class="stat-item">
                                <div class="stat-label">Numerator</div>
                                <div class="stat-value">@measure.Numerator.ToString("N0")</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-label">Denominator</div>
                                <div class="stat-value">@measure.Denominator.ToString("N0")</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-label">Gaps</div>
                                <div class="stat-value" style="color: #ff8c00;">@measure.GapCount.ToString("N0")</div>
                            </div>
                        </div>

                        <div class="progress-bar-container">
                            <div class="progress-bar" style="width: @measure.Rate%; background: @GetRateColor(measure.Rate);"></div>
                        </div>

                        <div class="measure-actions">
                            <button class="btn btn-secondary btn-sm" @onclick="() => ViewMeasureDetails(measure.MeasureId)">
                                Details
                            </button>
                            <button class="btn btn-primary btn-sm" @onclick="() => ViewGaps(measure.MeasureId)">
                                View Gaps (@measure.GapCount)
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Gap Closure Modal -->
    @if (selectedMeasureId != null)
    {
        <div class="modal-overlay" @onclick="CloseGapModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h4>Care Gaps - @selectedMeasureId</h4>
                    <button class="btn-close" @onclick="CloseGapModal">&times;</button>
                </div>
                <div class="modal-body">
                    @if (gapPatients != null)
                    {
                        <div class="gap-summary">
                            <p><strong>Total Gaps:</strong> @gapPatients.Count</p>
                            <p><strong>Outreach Recommendation:</strong> @outreachRecommendation</p>
                        </div>

                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Patient</th>
                                    <th>Age</th>
                                    <th>Priority</th>
                                    <th>Risk</th>
                                    <th>Last Service</th>
                                    <th>Recommended Action</th>
                                    <th>PCP</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var patient in gapPatients.Take(50))
                                {
                                    <tr>
                                        <td>@patient.PatientName</td>
                                        <td>@patient.Age</td>
                                        <td>
                                            <span class="priority-badge priority-@patient.Priority">
                                                @GetPriorityLabel(patient.Priority)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="risk-badge risk-@patient.RiskLevel.ToLower()">
                                                @patient.RiskLevel
                                            </span>
                                        </td>
                                        <td>@(patient.LastServiceDate ?? "Never")</td>
                                        <td><small>@patient.RecommendedAction</small></td>
                                        <td><small>@patient.PrimaryCareProvider</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 2rem;">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p>Loading gap patients...</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private HedisDashboardResponse? dashboard;
    private List<GapPatient>? gapPatients;
    private string? selectedMeasureId;
    private string? outreachRecommendation;
    private string selectedCategory = "All";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        try
        {
            // Call backend API (use mock for now with USE_MOCK_SERVICES=true)
            var apiUrl = "http://localhost:7071/api/hedis/dashboard?planSegment=All Plans&year=2025";
            dashboard = await Http.GetFromJsonAsync<HedisDashboardResponse>(apiUrl);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
            // Fallback to mock data
            dashboard = GetMockDashboard();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ViewGaps(string measureId)
    {
        selectedMeasureId = measureId;
        gapPatients = null;

        try
        {
            var apiUrl = $"http://localhost:7071/api/hedis/gaps/{measureId}?planSegment=All Plans&year=2025&top=100";
            var response = await Http.GetFromJsonAsync<GapsResponse>(apiUrl);
            gapPatients = response?.Gaps ?? new List<GapPatient>();
            outreachRecommendation = response?.OutreachRecommendation;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading gaps: {ex.Message}");
            gapPatients = new List<GapPatient>();
        }
    }

    private void CloseGapModal()
    {
        selectedMeasureId = null;
        gapPatients = null;
    }

    private void ViewMeasureDetails(string measureId)
    {
        Navigation.NavigateTo($"/hedis-measure/{measureId}");
    }

    private void HandleCategoryFilter(ChangeEventArgs e)
    {
        selectedCategory = e.Value?.ToString() ?? "All";
    }

    private IEnumerable<MeasureResult> GetFilteredMeasures()
    {
        if (dashboard == null) return Enumerable.Empty<MeasureResult>();

        return selectedCategory == "All" 
            ? dashboard.Measures 
            : dashboard.Measures.Where(m => m.MeasureCategory == selectedCategory);
    }

    private string GetRateColor(double rate)
    {
        return rate >= 80 ? "#107c10" : rate >= 60 ? "#ff8c00" : "#d13438";
    }

    private string GetPriorityLabel(int priority)
    {
        return priority switch
        {
            5 => "Critical",
            4 => "High",
            3 => "Medium",
            2 => "Low",
            _ => "Standard"
        };
    }

    private HedisDashboardResponse GetMockDashboard()
    {
        return new HedisDashboardResponse
        {
            MeasurementYear = 2025,
            PlanSegment = "All Plans",
            OverallStarRating = 4.0,
            ProjectedStarRating = 4.5,
            TotalMembers = 50000,
            TotalGaps = 6050,
            LastUpdated = DateTime.UtcNow,
            Measures = new List<MeasureResult>
            {
                new() { MeasureId = "BCS", MeasureName = "Breast Cancer Screening", MeasureCategory = "Prevention & Screening", Denominator = 3750, Numerator = 2550, Rate = 68.0, GapCount = 1200 },
                new() { MeasureId = "COL", MeasureName = "Colorectal Cancer Screening", MeasureCategory = "Prevention & Screening", Denominator = 4200, Numerator = 3024, Rate = 72.0, GapCount = 1176 },
                new() { MeasureId = "CBP", MeasureName = "Controlling High Blood Pressure", MeasureCategory = "Effectiveness of Care", Denominator = 6500, Numerator = 5525, Rate = 85.0, GapCount = 975 },
                new() { MeasureId = "HBD", MeasureName = "HbA1c Control for Diabetes", MeasureCategory = "Effectiveness of Care", Denominator = 5500, Numerator = 3410, Rate = 62.0, GapCount = 2090 }
            },
            PriorityActions = new List<PriorityAction>
            {
                new() { MeasureId = "HBD", MeasureName = "HbA1c Control for Diabetes", GapCount = 2090, CurrentRate = 62.0, TargetRate = 77.0, StarRatingImpact = 0.45, RecommendedApproach = "Targeted outreach: Care manager calls + provider alerts" }
            }
        };
    }

    // Response models
    public class HedisDashboardResponse
    {
        public int MeasurementYear { get; set; }
        public string PlanSegment { get; set; } = "";
        public double OverallStarRating { get; set; }
        public double ProjectedStarRating { get; set; }
        public int TotalMembers { get; set; }
        public int TotalGaps { get; set; }
        public DateTime LastUpdated { get; set; }
        public List<MeasureResult> Measures { get; set; } = new();
        public List<PriorityAction> PriorityActions { get; set; } = new();
    }

    public class MeasureResult
    {
        public string MeasureId { get; set; } = "";
        public string MeasureName { get; set; } = "";
        public string MeasureCategory { get; set; } = "";
        public int Denominator { get; set; }
        public int Numerator { get; set; }
        public double Rate { get; set; }
        public int GapCount { get; set; }
    }

    public class PriorityAction
    {
        public string MeasureId { get; set; } = "";
        public string MeasureName { get; set; } = "";
        public int GapCount { get; set; }
        public double CurrentRate { get; set; }
        public double TargetRate { get; set; }
        public double StarRatingImpact { get; set; }
        public string RecommendedApproach { get; set; } = "";
    }

    public class GapsResponse
    {
        public List<GapPatient> Gaps { get; set; } = new();
        public string? OutreachRecommendation { get; set; }
    }

    public class GapPatient
    {
        public string PatientName { get; set; } = "";
        public int Age { get; set; }
        public int Priority { get; set; }
        public string RiskLevel { get; set; } = "";
        public string? LastServiceDate { get; set; }
        public string RecommendedAction { get; set; } = "";
        public string PrimaryCareProvider { get; set; } = "";
    }
}

