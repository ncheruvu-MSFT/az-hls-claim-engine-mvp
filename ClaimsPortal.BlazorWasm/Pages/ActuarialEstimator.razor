@page "/actuarial"
@using ClaimsPortal.BlazorWasm.Services
@using ClaimsPortal.BlazorWasm.Models
@using ClaimsPortal.BlazorWasm.Components
@inject ActuarialService ActuarialService

<PageTitle>Actuarial Estimator - ClaimsIQ Platform</PageTitle>

<style>
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .page-header h3 {
        margin: 0 0 0.5rem 0;
        font-size: 1.75rem;
    }

    .subtitle {
        margin: 0;
        opacity: 0.9;
        font-size: 1rem;
    }

    .segment-selector {
        background: white;
        padding: 1rem;
        border-radius: 8px;
        box-shadow: var(--shadow);
        margin-bottom: 1.5rem;
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .segment-button {
        padding: 0.75rem 1.5rem;
        border: 2px solid #e0e0e0;
        background: white;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .segment-button:hover {
        border-color: var(--primary-color);
        color: var(--primary-color);
    }

    .segment-button.active {
        background: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
    }

    .period-selector {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-left: auto;
    }

    .period-selector label {
        font-weight: 600;
        color: var(--text-primary);
    }

    .period-selector select {
        padding: 0.5rem 1rem;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        font-size: 1rem;
    }

    .tabs {
        display: flex;
        gap: 0.5rem;
        border-bottom: 2px solid #e0e0e0;
        margin-bottom: 2rem;
    }

    .tab-button {
        padding: 1rem 2rem;
        background: transparent;
        border: none;
        border-bottom: 3px solid transparent;
        cursor: pointer;
        font-weight: 600;
        color: var(--text-secondary);
        transition: all 0.2s ease;
    }

    .tab-button:hover {
        color: var(--primary-color);
    }

    .tab-button.active {
        color: var(--primary-color);
        border-bottom-color: var(--primary-color);
    }

    .badge {
        display: inline-block;
        padding: 0.25rem 0.5rem;
        background: var(--error-color);
        color: white;
        border-radius: 12px;
        font-size: 0.75rem;
        margin-left: 0.5rem;
    }

    .loading-spinner {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 4rem;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #f3f3f3;
        border-top: 4px solid var(--primary-color);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

<div class="page-header">
    <h3>📊 Actuarial Estimator</h3>
    <p class="subtitle">Population risk forecasting and "what-if" scenario modeling</p>
</div>

<div class="segment-selector">
    <div>
        <strong>Segment:</strong>
    </div>
    <button class="segment-button @(selectedSegment == "All" ? "active" : "")" 
            @onclick="@(() => SelectSegment("All"))">
        All Plans
    </button>
    <button class="segment-button @(selectedSegment == "Plan_HMO_East" ? "active" : "")" 
            @onclick="@(() => SelectSegment("Plan_HMO_East"))">
        HMO East
    </button>
    <button class="segment-button @(selectedSegment == "Plan_PPO_West" ? "active" : "")" 
            @onclick="@(() => SelectSegment("Plan_PPO_West"))">
        PPO West
    </button>
    <button class="segment-button @(selectedSegment == "Plan_Medicare" ? "active" : "")" 
            @onclick="@(() => SelectSegment("Plan_Medicare"))">
        Medicare
    </button>

    <div class="period-selector">
        <label>Period:</label>
        <select @bind="selectedPeriod" @bind:after="LoadBaselineAsync">
            <option value="last6mo">Last 6 Months</option>
            <option value="last12mo">Last 12 Months</option>
            <option value="last18mo">Last 18 Months</option>
            <option value="last24mo">Last 24 Months</option>
        </select>
    </div>
</div>

<div class="tabs">
    <button class="tab-button @(activeTab == "baseline" ? "active" : "")" 
            @onclick="@(() => activeTab = "baseline")">
        📊 Baseline
    </button>
    <button class="tab-button @(activeTab == "builder" ? "active" : "")" 
            @onclick="@(() => activeTab = "builder")">
        ⚙️ Scenario Builder
    </button>
    <button class="tab-button @(activeTab == "compare" ? "active" : "")" 
            @onclick="@(() => activeTab = "compare")">
        📈 Compare
    </button>
    <button class="tab-button @(activeTab == "library" ? "active" : "")" 
            @onclick="@(() => activeTab = "library")">
        📚 Scenario Library
        @if (scenarios.Count > 0)
        {
            <span class="badge">@scenarios.Count</span>
        }
    </button>
</div>

@if (loading)
{
    <div class="loading-spinner">
        <div class="spinner"></div>
    </div>
}
else
{
    @if (activeTab == "baseline")
    {
        <BaselineView Baseline="@baseline" />
    }
    else if (activeTab == "builder")
    {
        <ScenarioBuilder Baseline="@baseline" OnScenarioCreated="HandleScenarioCreated" />
    }
    else if (activeTab == "compare")
    {
        <ScenarioCompare Baseline="@baseline" Scenarios="@scenarios" />
    }
    else if (activeTab == "library")
    {
        <ScenarioLibrary Scenarios="@scenarios" OnScenarioSelected="HandleScenarioSelected" />
    }
}

@code {
    private string activeTab = "baseline";
    private string selectedSegment = "Plan_HMO_East";
    private string selectedPeriod = "last12mo";
    private bool loading = true;

    private BaselineMetricsModel? baseline;
    private List<ScenarioModel> scenarios = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        await LoadBaselineAsync();
        await LoadScenariosAsync();
        loading = false;
    }

    private async Task SelectSegment(string segment)
    {
        selectedSegment = segment;
        await LoadBaselineAsync();
    }

    private async Task LoadBaselineAsync()
    {
        try
        {
            baseline = await ActuarialService.GetBaselineAsync(selectedSegment, selectedPeriod);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading baseline: {ex.Message}");
        }
    }

    private async Task LoadScenariosAsync()
    {
        try
        {
            scenarios = await ActuarialService.ListScenariosAsync("me");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading scenarios: {ex.Message}");
        }
    }

    private async Task HandleScenarioCreated(ScenarioModel scenario)
    {
        await LoadScenariosAsync();
        activeTab = "library";
    }

    private void HandleScenarioSelected(ScenarioModel scenario)
    {
        activeTab = "compare";
    }
}
