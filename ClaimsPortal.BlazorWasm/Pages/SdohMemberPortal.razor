@page "/sdoh-member"
@using ClaimsPortal.BlazorWasm.Services
@using ClaimsPortal.BlazorWasm.Models
@inject SdohService SdohService

<PageTitle>My Social Needs - ClaimsIQ</PageTitle>

<style>
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .page-header h3 {
        margin: 0 0 0.5rem 0;
        font-size: 1.75rem;
    }

    .subtitle {
        margin: 0;
        opacity: 0.9;
        font-size: 1rem;
    }

    .tabs {
        display: flex;
        gap: 0.5rem;
        border-bottom: 2px solid #e0e0e0;
        margin-bottom: 2rem;
    }

    .tab-button {
        padding: 1rem 2rem;
        background: transparent;
        border: none;
        border-bottom: 3px solid transparent;
        cursor: pointer;
        font-weight: 600;
        color: var(--text-secondary);
        transition: all 0.2s ease;
    }

    .tab-button:hover {
        color: var(--primary-color);
    }

    .tab-button.active {
        color: var(--primary-color);
        border-bottom-color: var(--primary-color);
    }

    .risk-dashboard {
        background: white;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: var(--shadow);
        margin-bottom: 2rem;
    }

    .risk-score-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 2rem;
    }

    .risk-score-value {
        font-size: 4rem;
        font-weight: 700;
        margin: 1rem 0;
    }

    .risk-score-label {
        font-size: 1.25rem;
        opacity: 0.9;
    }

    .risk-score-date {
        font-size: 0.875rem;
        opacity: 0.8;
        margin-top: 0.5rem;
    }

    .domains-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .domain-card {
        background: white;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: var(--shadow);
        border-left: 4px solid;
        transition: all 0.2s ease;
    }

    .domain-card:hover {
        box-shadow: var(--shadow-hover);
        transform: translateY(-2px);
    }

    .domain-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .domain-icon {
        font-size: 2rem;
    }

    .domain-name {
        font-weight: 600;
        font-size: 1rem;
        color: var(--text-primary);
    }

    .domain-risk {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .risk-score {
        font-size: 1.5rem;
        font-weight: 700;
    }

    .risk-level {
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .risk-low {
        background: #d4edda;
        color: #155724;
    }

    .risk-moderate {
        background: #fff3cd;
        color: #856404;
    }

    .risk-high {
        background: #f8d7da;
        color: #721c24;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        color: var(--text-primary);
    }

    .condition-list, .goal-list, .referral-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .condition-card, .goal-card, .referral-card {
        background: white;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: var(--shadow);
        border-left: 4px solid;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
    }

    .card-title {
        font-weight: 600;
        font-size: 1.125rem;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
    }

    .card-subtitle {
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

    .status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .status-active {
        background: #d1ecf1;
        color: #0c5460;
    }

    .status-completed {
        background: #d4edda;
        color: #155724;
    }

    .status-in-progress {
        background: #fff3cd;
        color: #856404;
    }

    .card-meta {
        display: flex;
        gap: 1.5rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
        margin-top: 1rem;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .resources-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 1.5rem;
    }

    .resource-card {
        background: white;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: var(--shadow);
        transition: all 0.2s ease;
    }

    .resource-card:hover {
        box-shadow: var(--shadow-hover);
        transform: translateY(-2px);
    }

    .resource-header {
        margin-bottom: 1rem;
    }

    .resource-name {
        font-weight: 600;
        font-size: 1.125rem;
        color: var(--text-primary);
        margin-bottom: 0.25rem;
    }

    .resource-type {
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

    .resource-description {
        margin-bottom: 1rem;
        color: var(--text-primary);
        line-height: 1.5;
    }

    .resource-contact {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
        margin-bottom: 1rem;
    }

    .resource-actions {
        display: flex;
        gap: 0.5rem;
    }

    .btn-primary, .btn-secondary {
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-primary {
        background: var(--primary-color);
        color: white;
    }

    .btn-primary:hover {
        background: var(--primary-hover);
    }

    .btn-secondary {
        background: transparent;
        color: var(--primary-color);
        border: 2px solid var(--primary-color);
    }

    .btn-secondary:hover {
        background: rgba(0, 120, 212, 0.1);
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: var(--text-secondary);
    }

    .empty-state-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }
</style>

<div class="page-header">
    <h3>👤 My Social Needs & Resources</h3>
    <p class="subtitle">Understanding and addressing factors that impact your health and wellbeing</p>
</div>

<div class="tabs">
    <button class="tab-button @(activeTab == "overview" ? "active" : "")" 
            @onclick="@(() => activeTab = "overview")">
        📊 Overview
    </button>
    <button class="tab-button @(activeTab == "needs" ? "active" : "")" 
            @onclick="@(() => activeTab = "needs")">
        🎯 My Needs & Goals
    </button>
    <button class="tab-button @(activeTab == "resources" ? "active" : "")" 
            @onclick="@(() => activeTab = "resources")">
        🏢 Community Resources
    </button>
    <button class="tab-button @(activeTab == "history" ? "active" : "")" 
            @onclick="@(() => activeTab = "history")">
        📋 Screening History
    </button>
</div>

@if (loading)
{
    <div class="empty-state">
        <div class="empty-state-icon">⏳</div>
        <p>Loading your information...</p>
    </div>
}
else if (dashboard == null)
{
    <div class="empty-state">
        <div class="empty-state-icon">❌</div>
        <p>Unable to load dashboard data</p>
    </div>
}
else
{
    @if (activeTab == "overview")
    {
        <div class="risk-dashboard">
            <div class="risk-score-card">
                <div class="risk-score-label">Overall Social Needs Risk Score</div>
                <div class="risk-score-value">@dashboard.RiskScore.OverallRiskScore</div>
                <div class="risk-score-date">Last assessed: @dashboard.RiskScore.LastAssessmentDate.ToString("MMM dd, yyyy")</div>
            </div>

            <h4 class="section-title">Risk by Category</h4>
            <div class="domains-grid">
                @foreach (var (domain, score) in dashboard.RiskScore.DomainScores.OrderByDescending(x => x.Value))
                {
                    var riskLevel = dashboard.RiskScore.DomainRiskLevels.GetValueOrDefault(domain, "Low");
                    var borderColor = SdohDomains.GetRiskColor(riskLevel);
                    
                    <div class="domain-card" style="border-left-color: @borderColor">
                        <div class="domain-header">
                            <div class="domain-icon">@SdohDomains.GetDomainIcon(domain)</div>
                            <div class="domain-name">@domain</div>
                        </div>
                        <div class="domain-risk">
                            <div class="risk-score" style="color: @borderColor">@score</div>
                            <span class="risk-level @($"risk-{riskLevel.ToLower()}")">@riskLevel Risk</span>
                        </div>
                    </div>
                }
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 2rem;">
                <div class="domain-card" style="border-left-color: var(--error-color);">
                    <div class="card-subtitle">Active Needs</div>
                    <div class="card-title">@dashboard.RiskScore.ActiveConditionsCount</div>
                </div>
                <div class="domain-card" style="border-left-color: var(--primary-color);">
                    <div class="card-subtitle">Active Goals</div>
                    <div class="card-title">@dashboard.RiskScore.ActiveGoalsCount</div>
                </div>
                <div class="domain-card" style="border-left-color: var(--warning-color);">
                    <div class="card-subtitle">Active Referrals</div>
                    <div class="card-title">@dashboard.RiskScore.ActiveReferralsCount</div>
                </div>
                <div class="domain-card" style="border-left-color: var(--success-color);">
                    <div class="card-subtitle">Completed</div>
                    <div class="card-title">@dashboard.RiskScore.CompletedInterventionsCount</div>
                </div>
            </div>
        </div>
    }
    else if (activeTab == "needs")
    {
        <div class="risk-dashboard">
            <h4 class="section-title">🚨 My Current Needs</h4>
            @if (dashboard.ActiveConditions.Any())
            {
                <div class="condition-list">
                    @foreach (var condition in dashboard.ActiveConditions)
                    {
                        var borderColor = SdohDomains.GetRiskColor(condition.Severity);
                        <div class="condition-card" style="border-left-color: @borderColor">
                            <div class="card-header">
                                <div>
                                    <div class="card-title">
                                        @SdohDomains.GetDomainIcon(condition.Domain) @condition.Description
                                    </div>
                                    <div class="card-subtitle">@condition.Domain</div>
                                </div>
                                <span class="status-badge status-active">Active</span>
                            </div>
                            <div class="card-meta">
                                <div class="meta-item">
                                    <span>📅</span>
                                    <span>Since @condition.OnsetDate.ToString("MMM yyyy")</span>
                                </div>
                                <div class="meta-item">
                                    <span>⚠️</span>
                                    <span>@condition.Severity Severity</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-icon">✅</div>
                    <p>No active social needs identified</p>
                </div>
            }

            <h4 class="section-title" style="margin-top: 2rem;">🎯 My Goals</h4>
            @if (dashboard.ActiveGoals.Any())
            {
                <div class="goal-list">
                    @foreach (var goal in dashboard.ActiveGoals)
                    {
                        <div class="goal-card" style="border-left-color: var(--primary-color)">
                            <div class="card-header">
                                <div>
                                    <div class="card-title">
                                        @SdohDomains.GetDomainIcon(goal.Domain) @goal.Description
                                    </div>
                                    <div class="card-subtitle">@goal.Domain</div>
                                </div>
                                <span class="status-badge status-in-progress">@goal.AchievementStatus</span>
                            </div>
                            <div class="card-meta">
                                <div class="meta-item">
                                    <span>🚀</span>
                                    <span>Started @goal.StartDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                @if (goal.TargetDate.HasValue)
                                {
                                    <div class="meta-item">
                                        <span>🎯</span>
                                        <span>Target @goal.TargetDate.Value.ToString("MMM dd, yyyy")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <p>No active goals set. Talk to your care team about setting goals.</p>
                </div>
            }

            <h4 class="section-title" style="margin-top: 2rem;">📋 Active Referrals</h4>
            @if (dashboard.ActiveReferrals.Any())
            {
                <div class="referral-list">
                    @foreach (var referral in dashboard.ActiveReferrals)
                    {
                        <div class="referral-card" style="border-left-color: var(--warning-color)">
                            <div class="card-header">
                                <div>
                                    <div class="card-title">
                                        @SdohDomains.GetDomainIcon(referral.Domain) @referral.ServiceDescription
                                    </div>
                                    <div class="card-subtitle">Referred to: @referral.ReferralTarget</div>
                                </div>
                                <span class="status-badge status-active">@referral.Status</span>
                            </div>
                            <div class="card-meta">
                                <div class="meta-item">
                                    <span>📅</span>
                                    <span>Requested @referral.RequestedDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div class="meta-item">
                                    <span>👨‍⚕️</span>
                                    <span>By @referral.ReferralSource</span>
                                </div>
                                <div class="meta-item">
                                    <span>⚡</span>
                                    <span>@referral.Priority Priority</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <p>No active referrals</p>
                </div>
            }
        </div>
    }
    else if (activeTab == "resources")
    {
        <div class="risk-dashboard">
            <h4 class="section-title">🏢 Community Resources Near You</h4>
            <p style="color: var(--text-secondary); margin-bottom: 2rem;">
                These organizations provide services that may help with your social needs. Click "Request Referral" to connect with them.
            </p>

            @if (communityResources.Any())
            {
                <div class="resources-grid">
                    @foreach (var resource in communityResources)
                    {
                        <div class="resource-card">
                            <div class="resource-header">
                                <div class="resource-name">
                                    @string.Join(" ", resource.ServicesDomains.Select(d => SdohDomains.GetDomainIcon(d))) 
                                    @resource.Name
                                </div>
                                <div class="resource-type">@resource.Type • @($"{resource.DistanceMiles:N1}") miles away</div>
                            </div>
                            <div class="resource-description">@resource.Description</div>
                            <div class="resource-contact">
                                <div>📞 @resource.Phone</div>
                                <div>📍 @resource.AddressLine, @resource.City, @resource.State @resource.ZipCode</div>
                                <div>🕒 @resource.AvailabilityHours</div>
                                @if (!string.IsNullOrEmpty(resource.Website))
                                {
                                    <div>🌐 <a href="@resource.Website" target="_blank">@resource.Website</a></div>
                                }
                            </div>
                            <div class="resource-actions">
                                @if (resource.AcceptsReferrals)
                                {
                                    <button class="btn-primary" @onclick="() => RequestReferral(resource)">
                                        Request Referral
                                    </button>
                                }
                                <button class="btn-secondary" @onclick="() => GetDirections(resource)">
                                    Get Directions
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-icon">🏢</div>
                    <p>Loading community resources...</p>
                </div>
            }
        </div>
    }
    else if (activeTab == "history")
    {
        <div class="risk-dashboard">
            <h4 class="section-title">📋 My Screening History</h4>
            <p style="color: var(--text-secondary); margin-bottom: 2rem;">
                Last assessment: @dashboard.RiskScore.LastAssessmentDate.ToString("MMMM dd, yyyy") 
                using @dashboard.LatestScreening.FirstOrDefault()?.AssessmentTool
            </p>

            @if (dashboard.LatestScreening.Any())
            {
                <div class="condition-list">
                    @foreach (var screening in dashboard.LatestScreening.GroupBy(s => s.Domain))
                    {
                        <div class="condition-card" style="border-left-color: var(--primary-color)">
                            <div class="card-header">
                                <div>
                                    <div class="card-title">
                                        @SdohDomains.GetDomainIcon(screening.Key) @screening.Key
                                    </div>
                                    <div class="card-subtitle">@screening.Count() questions answered</div>
                                </div>
                            </div>
                            @foreach (var item in screening)
                            {
                                <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #e0e0e0;">
                                    <div style="font-weight: 600; margin-bottom: 0.5rem;">@item.QuestionText</div>
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <div style="color: var(--text-secondary);">Answer: @item.Answer</div>
                                        <span class="risk-level @($"risk-{item.RiskLevel.ToLower()}")">@item.RiskLevel Risk</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-icon">📋</div>
                    <p>No screening history available. Complete a screening to see results here.</p>
                </div>
            }

            <div style="text-align: center; margin-top: 2rem;">
                <button class="btn-primary" style="padding: 1rem 2rem;">
                    Take New Screening Assessment
                </button>
            </div>
        </div>
    }
}

@code {
    private string activeTab = "overview";
    private bool loading = true;
    private SdohDashboardModel? dashboard;
    private List<CommunityResourceModel> communityResources = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        try
        {
            // In production, get patient ID from authentication
            var patientId = "patient-123";
            
            dashboard = await SdohService.GetDashboardAsync(patientId);
            communityResources = await SdohService.SearchCommunityResourcesAsync("", "98101", 10);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading SDOH data: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void RequestReferral(CommunityResourceModel resource)
    {
        Console.WriteLine($"Request referral to: {resource.Name}");
        // TODO: Implement referral request flow
    }

    private void GetDirections(CommunityResourceModel resource)
    {
        var address = $"{resource.AddressLine}, {resource.City}, {resource.State} {resource.ZipCode}";
        var mapsUrl = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(address)}";
        // In real implementation, open in new window
        Console.WriteLine($"Open maps: {mapsUrl}");
    }
}
